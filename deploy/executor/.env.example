# Copy to deploy/executor/.env on the execution VM. Git-ignored: never commit real values.

# Host name for HTTPS. Without a domain, use <VM public IP with dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=

# Shared secret with the website (the same value as Render's Sandbox__Remote__Key).
# Generate: openssl rand -base64 32
Executor__Key=

# Only these networks may call /v1 (Render's outbound IPs for the web service, from the Render
# dashboard: Service -> Connect -> Outbound). Leave unset only for testing.
# Executor__AllowedNetworks__0=
# Executor__AllowedNetworks__1=

# Group id owning /var/run/docker.sock on the VM:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
