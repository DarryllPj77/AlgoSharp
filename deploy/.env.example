# Copy to deploy/.env and fill in. deploy/.env is git-ignored: never commit real values.

# Public host name; Caddy gets an HTTPS certificate for it (point its DNS A/AAAA record at the VM first).
DOMAIN=algosharp.example.com

# Neon connection string (Neon console -> Connect -> "Connection string"). Either form works:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   Host=HOST;Database=DBNAME;Username=USER;Password=PASSWORD;SSL Mode=Require
# TLS is enforced for any non-local host even if sslmode is missing.
ConnectionStrings__AlgoSharp=

# Group id that owns /var/run/docker.sock on the VM:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
