{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "UseUtcTimestamp": true, "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ" }
    }
  },
  "AllowedHosts": "*",
  "Executor": {
    "MaxRequestBytes": 524288,
    "MaxCases": 10,
    "PerCallerPer10Minutes": 30,
    "PerCallerPerDay": 300,
    "PerCallerConcurrent": 1,
    "GlobalPerMinute": 120,
    "SelfTestMinutes": 10,
    "AllowedNetworks": []
  },
  "Sandbox": {
    "Mode": "Docker",
    "Image": "algosharp-runner:1",
    "Runtime": "",
    "TimeoutSeconds": 15,
    "Memory": "256m",
    "Cpus": "1",
    "PidsLimit": 64,
    "MaxConcurrentRuns": 2,
    "MaxEvents": 2000,
    "MaxOutputChars": 8000
  }
}
