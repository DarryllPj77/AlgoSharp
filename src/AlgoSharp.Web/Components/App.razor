<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AlgoSharp — learn data structures and algorithms through interactive, step-by-step visualizations of real C# code." />
    <base href="/" />
    <script>
        try { const t = localStorage.getItem("algosharp-theme"); if (t) document.documentElement.dataset.theme = t; } catch { }
    </script>
    <ResourcePreloader />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23e7eaf0'/><text x='16' y='21' font-family='monospace' font-size='13' font-weight='700' text-anchor='middle' fill='%230b0d12'>A%23</text></svg>" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AlgoSharp.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
