<div class="stage-legend">
    @foreach (var (state, label) in Items)
    {
        <span><i style="background:var(--st-@state)"></i>@label</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    private IEnumerable<(string, string)> Items => Kind switch
    {
        "bubble-sort" => [("compare", "Comparing"), ("swap", "Swapped"), ("sorted", "Final position")],
        "selection-sort" => [("compare", "Scanning"), ("min", "Current minimum"), ("swap", "Swapped"), ("sorted", "Sorted prefix")],
        "insertion-sort" => [("key", "Key being inserted"), ("compare", "Comparing"), ("swap", "Shifted"), ("sorted", "Sorted prefix")],
        "merge-sort" => [("compare", "Comparing halves"), ("new", "Written back"), ("active", "Merged range"), ("sorted", "Done")],
        "quick-sort" => [("pivot", "Pivot"), ("compare", "Comparing"), ("swap", "Swapped"), ("sorted", "Pivot placed")],
        "linear-search" or "binary-search" => [("compare", "Checking"), ("visited", "Ruled out"), ("found", "Found")],
        "linked-list" => [("active", "Walking"), ("compare", "Comparing"), ("new", "New node"), ("removed", "Removed"), ("found", "Found")],
        "bst" => [("compare", "Comparing"), ("active", "Path / parent"), ("new", "New / replaced"), ("removed", "Being deleted"), ("found", "Found / visited")],
        "binary-heap" => [("compare", "Parent vs child"), ("swap", "Swapped"), ("min", "Smallest child"), ("new", "New value"), ("found", "Heap OK")],
        "hash-table" => [("key", "Target bucket"), ("compare", "Comparing"), ("new", "Inserted"), ("removed", "Removed"), ("found", "Found")],
        "graph-traversal" => [("key", "Current"), ("pivot", "Discovered"), ("sorted", "Finished / tree edge"), ("compare", "Checking")],
        "dijkstra" => [("key", "Settling"), ("pivot", "In queue"), ("sorted", "Settled / path tree"), ("compare", "Relaxing")],
        "mst" => [("compare", "Considering"), ("sorted", "In the MST"), ("visited", "Rejected (faded)")],
        "recursion-tree" => [("key", "Current call"), ("active", "Waiting on stack"), ("sorted", "Returned"), ("found", "Memo hit")],
        _ => [("compare", "Checking"), ("swap", "Moved"), ("new", "Written"), ("removed", "Removed"), ("found", "Result")],
    };
}
