@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inherits AccountForm<ChangePassword.Model>

<PageTitle>Change password · AlgoSharp</PageTitle>

<AuthShell Title="Change password" Subtitle="Other devices signed in to this account will be signed out." Error="@FormError">
    <ChildContent>
        <EditForm EditContext="Edit" method="post" FormName="change-password" OnValidSubmit="Save" OnInvalidSubmit="ClearSecrets" novalidate>
            <DataAnnotationsValidator />
            <PasswordField Id="current" Label="Current password" @bind-Value="Input!.CurrentPassword" Autocomplete="current-password" />
            <PasswordField Id="new" Label="New password" @bind-Value="Input!.NewPassword" Autocomplete="new-password"
                           Hint="@($"At least {AccountRules.PasswordMin} characters, with a letter and a digit.")" />
            <PasswordField Id="confirm" Label="Confirm new password" @bind-Value="Input!.ConfirmPassword" Autocomplete="new-password" MatchId="new" />
            <div class="auth-actions">
                <button type="submit" class="btn btn-primary">Change password</button>
                <a class="btn btn-ghost" href="/account">Cancel</a>
            </div>
        </EditForm>
    </ChildContent>
</AuthShell>

@code {
    public sealed class Model
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string? CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Choose a new password.")]
        [StringLength(128, MinimumLength = AccountRules.PasswordMin, ErrorMessage = "Passwords need at least 8 characters.")]
        public string? NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Type the new password again.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The new passwords don't match.")]
        public string? ConfirmPassword { get; set; } = "";
    }

    private async Task Save()
    {
        string current = Input!.CurrentPassword ?? "", next = Input.NewPassword ?? "";
        Input.CurrentPassword = Input.NewPassword = Input.ConfirmPassword = "";
        if (current == next)
        {
            Show(AccountResult.Fail("Choose a password different from your current one.", nameof(Model.NewPassword)));
            return;
        }
        var result = await Accounts.ChangePasswordAsync(HttpContext.User, current, next);
        if (result.Succeeded) Nav.NavigateTo("/account?done=password", forceLoad: true);
        else Show(result);
    }
}
