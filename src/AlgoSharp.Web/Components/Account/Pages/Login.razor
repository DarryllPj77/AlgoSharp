@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inherits AccountForm<Login.Model>

<PageTitle>Sign in · AlgoSharp</PageTitle>

<AuthShell Title="Welcome back" Subtitle="Sign in with your username or email." Error="@FormError" Notice="@Notice">
    <ChildContent>
        @if (!Accounts.Enabled)
        {
            <p class="auth-text">@AccountService.NotConfigured</p>
        }
        else if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            <p class="auth-text">You're signed in as <b>@HttpContext.User.Identity.Name</b>.</p>
            <div class="auth-actions">
                <a class="btn btn-primary" href="@Safe">Continue</a>
                <a class="btn" href="/account">Your profile</a>
            </div>
        }
        else
        {
            <EditForm EditContext="Edit" method="post" FormName="login" OnValidSubmit="SignIn" OnInvalidSubmit="ClearSecrets" novalidate>
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="login">Username or email</label>
                    <InputText id="login" @bind-Value="Input!.Login" autocomplete="username" autofocus />
                    <ValidationMessage For="() => Input!.Login" class="field-error" />
                </div>
                <PasswordField Id="password" Label="Password" @bind-Value="Input!.Password" Autocomplete="current-password" />
                <label class="check">
                    <InputCheckbox @bind-Value="Input!.RememberMe" />
                    <span>Keep me signed in on this device <small>(for 14 days; leave off on shared computers)</small></span>
                </label>
                <button type="submit" class="btn btn-primary auth-submit">Sign in</button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        @if (Accounts.Enabled && HttpContext.User.Identity?.IsAuthenticated != true)
        {
            <span>New to AlgoSharp? <a href="@RegisterHref">Create an account</a></span>
        }
        <span>Accounts are optional. <a href="/">Keep exploring without one</a></span>
    </Footer>
</AuthShell>

@code {
    public sealed class Model
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        [StringLength(256)]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [StringLength(128)]
        public string? Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "done")] private string? Done { get; set; }

    private string Safe => AlgoSharp.Accounts.ReturnUrl.Safe(ReturnUrl);
    private string RegisterHref => ReturnUrl is null ? "/account/register" : $"/account/register?returnUrl={Uri.EscapeDataString(Safe)}";
    private string? Notice => Done switch
    {
        "signedout" => "You've been signed out.",
        "everywhere" => "You've been signed out on every device. Sign in again to continue.",
        _ => null,
    };

    private async Task SignIn()
    {
        var outcome = await Accounts.SignInAsync(Input!.Login, Input.Password ?? "", Input.RememberMe);
        Input.Password = ""; // never echo a password back into the page
        switch (outcome)
        {
            case SignInOutcome.Succeeded:
                Nav.NavigateTo(Safe, forceLoad: true);
                break;
            case SignInOutcome.LockedOut:
                FormError = $"Too many incorrect attempts. This account is locked for {AccountRules.LockoutDuration.TotalMinutes:0} minutes. Try again later.";
                break;
            case SignInOutcome.NotAllowed:
                FormError = "This account isn't allowed to sign in yet.";
                break;
            case SignInOutcome.Unavailable:
                FormError = Accounts.Enabled ? AccountService.Unavailable : AccountService.NotConfigured;
                break;
            default:
                FormError = AccountService.BadCredentials;
                break;
        }
    }
}
