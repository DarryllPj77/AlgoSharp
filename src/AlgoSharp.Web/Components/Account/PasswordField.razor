@using System.Linq.Expressions
@* A password input with a show/hide button (handled by js/forms.js) and its validation message. *@
<div class="field">
    <label for="@Id">@Label @if (Aside is not null) { <span class="field-aside">@Aside</span> }</label>
    <div class="pw-wrap">
        <InputText id="@Id" type="password" autocomplete="@Autocomplete"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                   data-match="@MatchId" aria-describedby="@(Id + "-help")" />
        <button type="button" class="pw-toggle" data-reveal="@Id" aria-label="Show password" aria-pressed="false">Show</button>
    </div>
    @if (MatchId is not null)
    {
        <span id="@(Id + "-match")" class="field-hint" aria-live="polite"></span>
    }
    @if (Hint is not null)
    {
        <span id="@(Id + "-help")" class="field-hint">@Hint</span>
    }
    <ValidationMessage For="@ValueExpression" class="field-error" />
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    /// <summary>Id of the password input this one must match (for live "passwords match" feedback).</summary>
    [Parameter] public string? MatchId { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>> ValueExpression { get; set; } = default!;
}
