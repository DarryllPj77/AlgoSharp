@using System.Globalization
@* Theory (Big-O) next to what the real C# actually did on this input and on larger inputs. *@

<section class="perf">
    <header class="perf-head">
        <h2>Performance comparison</h2>
        <p>
            Operation counts come from running the same C# code with counters, not from animation time.
            Animation speed is just playback and says nothing about how fast an algorithm is.
        </p>
    </header>

    <div class="perf-grid">
        <div class="box-card">
            <header><Icon Name="clock" /> On your input <span class="muted">n = @Input.Numbers.Length</span></header>
            <div class="body">
                <table class="perf-table">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var r in Runs)
                            {
                                <th>@r.Approach.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr><th>Technique</th>@foreach (var r in Runs) { <td>@r.Approach.Technique</td> }</tr>
                        <tr class="theory"><th>Time (average / worst)</th>@foreach (var r in Runs) { <td><code>@r.Approach.Complexity.Average</code> / <code>@r.Approach.Complexity.Worst</code></td> }</tr>
                        <tr class="theory"><th>Extra space</th>@foreach (var r in Runs) { <td><code>@r.Approach.Complexity.Space</code></td> }</tr>
                        @foreach (var name in CounterNames)
                        {
                            <tr class="observed"><th>@name</th>@foreach (var r in Runs) { <td>@(r.Counters.TryGetValue(name, out var v) ? v.ToString("N0") : "—")</td> }</tr>
                        }
                        <tr class="observed total"><th>Total operations</th>@foreach (var r in Runs) { <td class="@(r == Best ? "best" : "")">@r.Operations.ToString("N0")</td> }</tr>
                        <tr class="observed"><th>Steps recorded</th>@foreach (var r in Runs) { <td>@r.Steps.Count</td> }</tr>
                        <tr><th>Result</th>@foreach (var r in Runs) { <td><code>[@string.Join(", ", r.Result)]</code></td> }</tr>
                    </tbody>
                </table>
                <p class="perf-legend"><span class="tag theory">theory</span> Big-O from analysis · <span class="tag observed">observed</span> counted while the code ran</p>
                @if (Best is { } best && best.Approach != Runs[^1].Approach)
                {
                    <p class="perf-note">On this small input, @best.Approach.Name did less work. Big-O describes how cost grows with n, so a slower algorithm can still win on a few elements. The scaling panel shows the worst case as n grows.</p>
                }
                <p class="perf-note">Totals add different kinds of operations (a comparison isn't the same cost as a hash lookup). Compare how they grow rather than small absolute numbers.</p>
            </div>
        </div>

        <div class="box-card">
            <header><Icon Name="bolt" /> How it scales <span class="muted">worst case: no pair exists</span></header>
            <div class="body">
                @foreach (var group in Scale.GroupBy(s => s.N))
                {
                    long max = Scale.Max(s => s.Point.Total);
                    <div class="scale-row">
                        <div class="scale-n">n = @group.Key.ToString("N0")</div>
                        <div class="scale-bars">
                            @foreach (var s in group)
                            {
                                <div class="scale-bar">
                                    <span class="lbl">@s.Approach.Name</span>
                                    <span class="track"><i class="ap-@s.Approach.Key" style="width:@Width(s.Point.Total, max)"></i></span>
                                    <span class="num">@s.Point.Total.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                <p class="perf-note">
                    Bars use a logarithmic scale. When n grows 10×, brute force does about 100× more work while the
                    hash map does about 10× more. That's the difference between O(n²) and O(n).
                </p>
            </div>
        </div>
    </div>

    <div class="tradeoffs">
        @foreach (var r in Runs)
        {
            <div class="box-card">
                <header><span class="ap-dot ap-@r.Approach.Key"></span> @r.Approach.Name: trade-offs</header>
                <div class="body">
                    <p class="op-summary" style="margin-top:0">@r.Approach.Idea</p>
                    <ul class="ideas">
                        @foreach (var t in r.Approach.Tradeoffs)
                        {
                            <li>@t</li>
                        }
                    </ul>
                    <p class="cx-note">@r.Approach.Complexity.Note</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ProblemInput Input { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ApproachRun> Runs { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<(ApproachDef Approach, int N, ScalePoint Point)> Scale { get; set; } = [];

    private IEnumerable<string> CounterNames => Runs.SelectMany(r => r.Counters.Keys).Distinct();

    private ApproachRun? Best => Runs.Count < 2 ? null : Runs.MinBy(r => r.Operations);

    private static string Width(long value, long max)
    {
        double w = value <= 0 ? 0 : Math.Log10(value + 1) / Math.Log10(max + 1) * 100;
        return Math.Max(1.5, w).ToString("0.#", CultureInfo.InvariantCulture) + "%";
    }
}
