@* One approach's visual state for a step: callout, the array, and (if used) the dictionary. *@

<div class="ps-stage">
    <div class="ps-callout tone-@(Step?.Callout?.Tone.ToString().ToLowerInvariant() ?? "none")">
        @if (Step?.Callout is { } c)
        {
            <span @key="c.Text">@c.Text</span>
        }
    </div>
    @if (Step?.Array is { } arr)
    {
        <ArrayCanvas Frame="arr" />
    }
    @if (Step?.Map is { } map)
    {
        <MapCanvas Frame="map" />
    }
</div>

@code {
    [Parameter] public Step? Step { get; set; }
}
