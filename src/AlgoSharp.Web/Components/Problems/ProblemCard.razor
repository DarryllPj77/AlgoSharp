<a class="card cat-searching" href="/problems/@Problem.Slug" style="--i:@Index">
    <div class="card-body">
        <span class="card-cat">LeetCode #@Problem.Number · @Problem.Difficulty</span>
        <h3 class="card-title">@Problem.Title</h3>
        <div class="ps-tags">
            <span class="tag-chip">@Problem.Category</span>
        </div>
        <p class="card-text">@Summary</p>
        <code class="ps-sig">@Problem.Entry.Description</code>
        <div class="card-foot">
            <span>@Problem.DefaultCases.Count test cases</span>
            <span class="card-go">Solve it <Icon Name="arrow" /></span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public PlaygroundProblem Problem { get; set; } = default!;
    [Parameter] public int Index { get; set; }

    private string Summary
    {
        get
        {
            string d = Problem.Description;
            int dot = d.IndexOf(". ", StringComparison.Ordinal);
            string first = dot > 0 ? d[..(dot + 1)] : d;
            return first.Length > 150 ? first[..147] + "…" : first;
        }
    }
}
