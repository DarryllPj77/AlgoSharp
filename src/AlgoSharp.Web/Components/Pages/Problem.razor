@page "/problems/{Slug}"
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (problem is not { Available: true })
{
    <PageTitle>Problem not found · AlgoSharp</PageTitle>
    <div class="page container empty">
        <h1 style="font-size:32px;margin-bottom:10px">@(problem?.Title ?? "Unknown problem")</h1>
        <p>@(problem is null ? "We couldn't find that problem." : "This problem is on the roadmap.") <a href="/problems" style="color:var(--brand)">Back to problems</a>.</p>
    </div>
}
else
{
    <PageTitle>@problem.Title · Problem Solving · AlgoSharp</PageTitle>
    <div class="page cat-searching">
        <div class="viz-header">
            <div class="viz-header-inner">
                <div>
                    <div class="crumbs"><a href="/problems">Problem Solving</a><span>/</span><span>LeetCode #@problem.Number</span></div>
                    <div class="viz-title">
                        <h1>@problem.Title</h1>
                        <span class="pill">@problem.Difficulty</span>
                        @foreach (var t in problem.Techniques)
                        {
                            <span class="tag-chip">@t</span>
                        }
                    </div>
                </div>
                <div class="viz-header-right">
                    <div class="mode-tabs" role="tablist" aria-label="Approach">
                        @foreach (var a in problem.Approaches)
                        {
                            <button role="tab" class="@(mode == a.Key ? "on" : "")" @onclick="() => SetMode(a.Key)"><span class="ap-dot ap-@a.Key"></span>@a.Name</button>
                        }
                        <button role="tab" class="@(mode == Compare ? "on" : "")" @onclick="() => SetMode(Compare)">Side by side</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="ps-page">
            <!-- ============ problem + input ============ -->
            <div class="ps-top">
                <div class="box-card">
                    <header><Icon Name="info" /> Problem</header>
                    <div class="body">
                        <p class="ps-statement">@problem.Statement</p>
                        <div class="ps-examples">
                            @foreach (var ex in problem.Examples)
                            {
                                <button class="ps-example" title="Load this example" @onclick="() => LoadExample(ex)">
                                    <code>@ex.Input</code>
                                    <span>→ <code>@ex.Output</code></span>
                                    <small>@ex.Explanation</small>
                                </button>
                            }
                        </div>
                        <ul class="ps-constraints">
                            @foreach (var c in problem.Constraints)
                            {
                                <li>@c</li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="box-card">
                    <header><Icon Name="vars" /> Input</header>
                    <div class="body">
                        <div class="field" style="margin-top:0">
                            <label for="nums">nums</label>
                            <input id="nums" class="@(error is null ? "" : "invalid")" value="@numbersText" spellcheck="false"
                                   @onchange="e => numbersText = e.Value?.ToString() ?? string.Empty" @onkeydown="OnInputKey" />
                        </div>
                        <div class="field">
                            <label for="target">@problem.TargetLabel</label>
                            <input id="target" class="@(error is null ? "" : "invalid")" value="@targetText" inputmode="numeric"
                                   @onchange="e => targetText = e.Value?.ToString() ?? string.Empty" @onkeydown="OnInputKey" />
                        </div>
                        @if (error is not null)
                        {
                            <p class="field-error" style="margin-top:8px">@error</p>
                        }
                        else
                        {
                            <p class="field-hint" style="margin-top:8px">@ProblemDef.MinCount–@ProblemDef.MaxCount numbers from @ProblemDef.MinValue to @ProblemDef.MaxValue. Duplicates and negatives allowed.</p>
                        }
                        <div class="actions-row">
                            <button class="btn btn-sm btn-accent" @onclick="Apply"><Icon Name="play" /> Run</button>
                            <button class="btn btn-sm" @onclick="RandomInput"><Icon Name="shuffle" /> Random</button>
                            <button class="btn btn-sm btn-ghost" @onclick="() => Load(problem.DefaultInput)"><Icon Name="reset" /> Default</button>
                        </div>
                        <div class="ps-expected">
                            Expected: <code>@ExpectedText</code>
                        </div>
                    </div>
                </div>
            </div>

            @if (mode == Compare)
            {
                <!-- ============ side by side ============ -->
                <div class="compare-grid" style="--dur:@(player.AnimationMs)ms">
                    @foreach (var run in runs)
                    {
                        var step = StepOf(run);
                        bool finished = player.Index >= run.Steps.Count - 1;
                        <section class="compare-col">
                            <header class="compare-head">
                                <span class="ap-dot ap-@run.Approach.Key"></span>
                                <h2>@run.Approach.Name</h2>
                                <span class="tag-chip">@run.Approach.Technique</span>
                                <span class="compare-cx"><code>@run.Approach.Complexity.Worst</code> time · <code>@run.Approach.Complexity.Space</code> space</span>
                            </header>
                            <div class="stage">
                                <ProblemStage Step="step" />
                            </div>
                            <div class="message @(finished ? "done" : "")">
                                <span class="step-no">@(finished ? "done" : $"step {Math.Min(player.Index, run.Steps.Count - 1) + 1}") / @run.Steps.Count</span>
                                <p>@step?.Message</p>
                            </div>
                            <CounterStrip Counters="@(step?.Counters ?? [])" Previous="@PrevOf(run)?.Counters" />
                            <div class="box-card code-compact">
                                <header><Icon Name="code" /> C# <span class="muted">line @LineOf(run, step)</span></header>
                                <CodeViewer Region="CodeLibrary.Get(run.Approach.CodeId)" ActiveLine="LineOf(run, step)" />
                            </div>
                        </section>
                    }
                </div>
                <div class="compare-controls">
                    <PlaybackControls Player="player" />
                    <p class="field-hint">Both approaches advance one recorded step per tick. The one that needs fewer steps finishes first; the counters show the real work done.</p>
                </div>
            }
            else if (Single is { } run)
            {
                var step = player.Current;
                <!-- ============ single approach ============ -->
                <div class="ps-single" style="--dur:@(player.AnimationMs)ms">
                    <section class="panel-center">
                        <div class="stage">
                            <ProblemStage Step="step" />
                        </div>
                        <div class="message @(player.AtEnd && player.Steps.Count > 1 ? "done" : "")" aria-live="polite">
                            <span class="step-no">step @(player.Index + 1)</span>
                            <p @key="player.Index">@step?.Message</p>
                        </div>
                        <PlaybackControls Player="player" />
                        <CounterStrip Counters="@(step?.Counters ?? [])" Previous="@player.Previous?.Counters" Steps="run.Steps.Count" />
                    </section>
                    <aside class="panel-right">
                        <div class="box-card">
                            <header><Icon Name="code" /> C# · @run.Approach.Name <span class="muted">line @LineOf(run, step)</span></header>
                            <CodeViewer Region="CodeLibrary.Get(run.Approach.CodeId)" ActiveLine="LineOf(run, step)" />
                            <p class="code-note" style="padding-bottom:10px;border-radius:0 0 var(--r-lg) var(--r-lg)">The exact code that ran, from <code>AlgoSharp.Core</code>. Counting and step-recording calls are hidden.</p>
                        </div>
                        <div class="box-card">
                            <header><Icon Name="vars" /> Variables</header>
                            <div class="body">
                                <VariableInspector Vars="@(step?.Vars ?? [])" Previous="@player.Previous?.Vars" />
                            </div>
                        </div>
                        <div class="box-card">
                            <header><Icon Name="clock" /> Complexity · @run.Approach.Name</header>
                            <div class="body"><ComplexityPanel Value="run.Approach.Complexity" /></div>
                        </div>
                    </aside>
                </div>
            }

            <PerformancePanel Input="input" Runs="runs" Scale="Scaling" />
        </div>
    </div>
}

@code {
    private const string Compare = "compare";

    [Parameter] public string Slug { get; set; } = "";

    private readonly Player player = new();
    private readonly Random rng = new();
    private ProblemDef? problem;
    private ProblemInput input = new([], 0);
    private List<ApproachRun> runs = [];
    private string mode = Compare;
    private string numbersText = "";
    private string targetText = "";
    private string? error;
    private string? loadedSlug;

    private DotNetObjectReference<Problem>? selfRef;
    private IJSObjectReference? module;
    private IJSObjectReference? shortcuts;

    /// <summary>Worst-case operation counts measured once per problem with the real code (no steps recorded).</summary>
    private static readonly Dictionary<string, List<(ApproachDef, int, ScalePoint)>> ScaleCache = [];

    private List<(ApproachDef Approach, int N, ScalePoint Point)> Scaling
    {
        get
        {
            lock (ScaleCache)
            {
                if (!ScaleCache.TryGetValue(problem!.Slug, out var list))
                {
                    list = [];
                    foreach (int n in new[] { 10, 100, 1000 })
                    {
                        var worst = problem.WorstCase(n);
                        foreach (var a in problem.Approaches) list.Add((a, n, a.Measure(worst)));
                    }
                    ScaleCache[problem.Slug] = list;
                }
                return list;
            }
        }
    }

    private ApproachRun? Single => runs.FirstOrDefault(r => r.Approach.Key == mode);

    private string ExpectedText =>
        runs.FirstOrDefault() is { } r ? (r.Result.Length == 0 ? "[] (no pair)" : $"[{string.Join(", ", r.Result.Order())}]") : "";

    protected override void OnInitialized()
    {
        player.Changed += () => _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (loadedSlug == Slug) return;
        loadedSlug = Slug;
        problem = ProblemCatalog.Find(Slug);
        if (problem is { Available: true }) Load(problem.DefaultInput, autoplay: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            selfRef = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/app.js");
            shortcuts = await module.InvokeAsync<IJSObjectReference>("registerShortcuts", selfRef);
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task OnShortcut(string action) => InvokeAsync(() =>
    {
        switch (action)
        {
            case "toggle": player.Toggle(); break;
            case "next": player.Forward(); break;
            case "prev": player.Back(); break;
            case "first": player.First(); break;
            case "last": player.Last(); break;
            case "reset": player.Play(); break;
        }
    });

    private void SetMode(string m)
    {
        mode = m;
        LoadPlayer(autoplay: false);
    }

    private void Load(ProblemInput value, bool autoplay = true)
    {
        input = value;
        numbersText = string.Join(", ", value.Numbers);
        targetText = value.Target.ToString();
        error = null;
        runs = problem!.Approaches.Select(a => a.Run(value)).ToList();
        LoadPlayer(autoplay);
    }

    /// <summary>Single mode plays one approach; compare mode drives both with one timeline as long as the longer run.</summary>
    private void LoadPlayer(bool autoplay)
    {
        var steps = mode == Compare
            ? runs.MaxBy(r => r.Steps.Count)!.Steps
            : Single?.Steps ?? [];
        player.Load(steps, autoplay);
    }

    private void Apply()
    {
        try
        {
            Load(ProblemDef.Parse(numbersText, targetText));
        }
        catch (FormatException ex)
        {
            error = ex.Message;
        }
    }

    private async Task OnInputKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await Task.Yield();
        Apply();
    }

    private void RandomInput() => Load(problem!.RandomInput(rng));

    private void LoadExample(ProblemExample ex)
    {
        int eq = ex.Input.LastIndexOf('=');
        int open = ex.Input.IndexOf('['), close = ex.Input.IndexOf(']');
        try
        {
            Load(ProblemDef.Parse(ex.Input[(open + 1)..close], ex.Input[(eq + 1)..]));
        }
        catch (FormatException f)
        {
            error = f.Message;
        }
    }

    private Step? StepOf(ApproachRun run) =>
        run.Steps.Count == 0 ? null : run.Steps[Math.Min(player.Index, run.Steps.Count - 1)];

    private Step? PrevOf(ApproachRun run) =>
        player.Index == 0 || player.Index > run.Steps.Count - 1 ? null : run.Steps[player.Index - 1];

    private static int LineOf(ApproachRun run, Step? step) =>
        step is null ? 0 : CodeLibrary.Get(run.Approach.CodeId).LineOf(step.Label);

    public async ValueTask DisposeAsync()
    {
        player.Dispose();
        try
        {
            if (shortcuts is not null)
            {
                await shortcuts.InvokeVoidAsync("dispose");
                await shortcuts.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
