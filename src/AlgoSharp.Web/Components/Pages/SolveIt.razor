@page "/problems/{Slug}"
@page "/code/{Slug}"
@using AlgoSharp.Playground.Compilation
@using AlgoSharp.Playground.Execution
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PlaygroundService Service
@inject LocalLibrary Library
@inject NavigationManager Nav
@inject Quotas RunQuotas
@inject ICodeExecutor Executor
@inject BrowserRunner Browser
@inject SoundCues Sound
@inject ILogger<SolveIt> Log

@if (problem is null && Id is not null)
{
    <PageTitle>My Problems · AlgoSharp</PageTitle>
    <div class="page container empty">
        @if (storageError is not null)
        {
            <p>@storageError <a href="/problems/mine" style="color:var(--brand)">Back to My Problems</a>.</p>
        }
        else
        {
            <p>Loading your problem…</p>
        }
    </div>
}
else if (problem is null)
{
    <PageTitle>Problem not found · AlgoSharp</PageTitle>
    <div class="page container empty"><p>No problem called “@Slug”. <a href="/problems" style="color:var(--brand)">Back to problems</a>.</p></div>
}
else
{
    <PageTitle>@problem.Title · Solve it · AlgoSharp</PageTitle>
    <div class="page cat-searching">
        <div class="viz-header">
            <div class="viz-header-inner">
                <div>
                    @if (userProblem is { } up)
                    {
                        <div class="crumbs"><a href="/problems">Problem Solving</a><span>/</span><a href="/problems/mine">My Problems</a><span>/</span><span>@(up.Collection.Length > 0 ? up.Collection : "Uncategorized")</span></div>
                        <div class="viz-title">
                            <h1>@(up.Level is int lv ? $"Level {lv}: " : "")@up.Title</h1>
                            <span class="pill">@(up.Difficulty ?? "Unrated")</span>
                            <span class="status-chip s-@Status.ToString().ToLowerInvariant()">@StatusLabel</span>
                            @if (navCount > 1)
                            {
                                <div class="pnav-mini" aria-label="Problem navigation">
                                    @if (prevLink is { } pl)
                                    {
                                        <a class="pnav-step" href="@pl.Href" title="Previous: @pl.Title" aria-label="Previous problem: @pl.Title">‹</a>
                                    }
                                    else
                                    {
                                        <span class="pnav-step disabled" aria-hidden="true">‹</span>
                                    }
                                    <span class="pnav-pos">@(navIndex + 1) / @navCount</span>
                                    @if (nextLink is { } nl)
                                    {
                                        <a class="pnav-next @(Status == ProblemStatus.Solved || AllPassed ? "ready" : "")" href="@nl.Href" title="Next: @nl.Title">Next <span aria-hidden="true">›</span></a>
                                    }
                                    else
                                    {
                                        <span class="pnav-next disabled">Last problem</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="crumbs"><a href="/problems">Problem Solving</a><span>/</span><span>@problem.Category</span></div>
                        <div class="viz-title">
                            <h1>@problem.Number. @problem.Title</h1>
                            <span class="pill">@problem.Difficulty</span>
                            @if (navCount > 1)
                            {
                                <div class="pnav-mini" aria-label="Problem navigation">
                                    @if (prevLink is { } pl)
                                    {
                                        <a class="pnav-step" href="@pl.Href" title="Previous: @pl.Title" aria-label="Previous problem: @pl.Title">‹</a>
                                    }
                                    else
                                    {
                                        <span class="pnav-step disabled" aria-hidden="true">‹</span>
                                    }
                                    <span class="pnav-pos">@(navIndex + 1) / @navCount</span>
                                    @if (nextLink is { } nl)
                                    {
                                        <a class="pnav-next @(Status == ProblemStatus.Solved || AllPassed ? "ready" : "")" href="@nl.Href" title="Next: @nl.Title">Next <span aria-hidden="true">›</span></a>
                                    }
                                    else
                                    {
                                        <span class="pnav-next disabled">Last problem</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="viz-header-right">
                    @if (!signedIn)
                    {
                        <a class="btn btn-accent" href="@SignInHref"><Icon Name="code" /> Sign in to solve</a>
                    }
                    else
                    {
                    <span class="sandbox-status @(status?.Available == true ? "ok" : "off")" title="@status?.Message">
                        <i></i>@(status is null ? "Checking sandbox…" : status.Available ? (InBrowser ? "Runs in your browser" : "Sandbox ready") : "Execution disabled")
                    </span>
                    @if (userProblem is not null)
                    {
                        <span class="draft-state">@draftState</span>
                        <a class="btn btn-sm btn-ghost" href="/problems/mine/@Id/edit">Edit</a>
                    }
                    <button class="btn btn-sm btn-ghost" @onclick="ResetCode"><Icon Name="reset" /> Starter code</button>
                    <button class="btn btn-accent" disabled="@(running || status?.Available != true)" @onclick="Visualize">
                        <Icon Name="play" /> @(running ? "Running…" : "Run & visualize")
                    </button>
                    }
                </div>
            </div>
        </div>

        <div class="lab">
            <!-- ============ problem + editor ============ -->
            <section class="lab-left">
                <div class="box-card">
                    <header><Icon Name="info" /> Problem <span class="muted">@problem.Entry.Description</span></header>
                    <div class="body problem-body">
                        @if (userProblem is { } u)
                        {
                            <p class="mode-banner @(setup!.EffectiveMode == ProblemMode.Challenge ? "challenge" : "")"><b>@setup.EffectiveMode</b> · @setup.Explanation</p>
                            <p class="ps-statement" style="white-space:pre-line">@u.Description</p>
                            @if (u.Concepts.Count > 0)
                            {
                                <div class="ps-tags" style="margin-top:8px">@foreach (var c in u.Concepts) { <span class="tag-chip">@c</span> }</div>
                            }
                            @if (u.InputSpec is not null || u.OutputSpec is not null)
                            {
                                <dl class="io-spec">
                                    @if (u.InputSpec is not null) { <dt>Input</dt><dd>@u.InputSpec</dd> }
                                    @if (u.OutputSpec is not null) { <dt>Output</dt><dd>@u.OutputSpec</dd> }
                                </dl>
                            }
                            <div class="ps-examples">
                                @for (int k = 0; k < u.Examples.Count; k++)
                                {
                                    var ex = u.Examples[k];
                                    <div class="ps-example">
                                        <b>Example @(k + 1)</b>
                                        <span>Input: <code>@ex.Input</code></span>
                                        <span>Output: <code>@ex.Output</code></span>
                                        @if (ex.Explanation is not null) { <small>@ex.Explanation</small> }
                                    </div>
                                }
                            </div>
                            @if (u.Instructions is not null)
                            {
                                <p class="ps-statement" style="margin-top:10px;white-space:pre-line">@u.Instructions</p>
                            }
                        }
                        else
                        {
                        <p class="ps-statement">@problem.Description</p>
                        <div class="ps-examples">
                            @for (int k = 0; k < problem.Examples.Count; k++)
                            {
                                var ex = problem.Examples[k];
                                <div class="ps-example">
                                    <b>Example @(k + 1)</b>
                                    <code>@problem.Describe(ex.Args)</code>
                                    <span>Output: <code>@ex.Output</code></span>
                                    @if (ex.Explanation is not null)
                                    {
                                        <small>@ex.Explanation</small>
                                    }
                                </div>
                            }
                        </div>
                        }
                        <ul class="ps-constraints">
                            @foreach (var c in problem.Constraints)
                            {
                                <li>@c</li>
                            }
                        </ul>
                    </div>
                </div>

                @if (signedIn)
                {
                <div class="box-card lab-editor-card">
                    <header><Icon Name="code" /> Solution.cs <span class="muted">C# · your own names and style</span></header>
                    <div class="lab-editor" @ref="editorHost"></div>
                    @if (editorError is not null)
                    {
                        <p class="field-error" style="padding:10px 16px">@editorError</p>
                    }
                </div>

                <div class="box-card">
                    <header><Icon Name="info" /> Compiler <span class="muted">@(compile is null ? "" : compile.Errors.Any() ? $"{compile.Errors.Count()} error(s)" : "no errors")</span></header>
                    <div class="body diag-list">
                        @if (compile is null)
                        {
                            <p class="vars-empty">Compiling…</p>
                        }
                        else if (!compile.Diagnostics.Any())
                        {
                            <p class="diag ok">@(status?.Available == false ? "✓ Compiles. Running code isn't available here right now (see below)." : "✓ Compiles. Press Run & visualize to run it in the sandbox.")</p>
                        }
                        @foreach (var d in compile?.Diagnostics.Take(8) ?? [])
                        {
                            <button class="diag @d.Severity" @onclick="() => Reveal(d.Line)">
                                <span class="where">Line @d.Line</span><span>@d.Message</span><code>@d.Code</code>
                            </button>
                        }
                    </div>
                </div>

                @if (status is { Available: false })
                {
                    <div class="box-card sandbox-off">
                        <header><Icon Name="info" /> Why can't I run code?</header>
                        <div class="body">
                            <p>@status.Message</p>
                            <p class="field-hint" style="margin-top:8px">
                                AlgoSharp never runs your code inside the web server. Code runs only in a locked-down Docker container
                                (no network, read-only files, memory/CPU/time limits). Until that sandbox is available you can still edit,
                                compile and get feedback here, but nothing is executed.
                            </p>
                            <button class="btn btn-sm" style="margin-top:10px" @onclick="RefreshStatus"><Icon Name="reset" /> Check again</button>
                        </div>
                    </div>
                }
                }
            </section>

            <!-- ============ results + visualization ============ -->
            @if (!signedIn)
            {
                <section class="lab-right">
                    <div class="box-card workspace-gate">
                        <header><Icon Name="code" /> Your coding workspace</header>
                        <div class="body">
                            <h2>Sign in to access your coding workspace.</h2>
                            <p>The problem is free to read. To write C# in the editor, check it as you type, save drafts and track progress,
                                sign in or create a free account. You'll come straight back to this problem.</p>
                            <div class="auth-actions">
                                <a class="btn btn-primary" href="@SignInHref">Sign in</a>
                                <a class="btn" href="@SignUpHref">Create an account</a>
                            </div>
                        </div>
                    </div>
                </section>
            }
            else
            {
            <section class="lab-right">
                @if (run?.ExecutionError is { } execError)
                {
                    <div class="message error"><span class="step-no">sandbox</span><p>@execError</p></div>
                }
                @if (Selected is { } outcome)
                {
                    <div class="case-summary">
                        @if (run!.Cases.Any(c => c.Verdict?.Graded == true))
                        {
                            <b>@run.Cases.Count(c => c.Verdict?.Graded == true && c.Verdict.Passed) / @run.Cases.Count(c => c.Verdict?.Graded == true) passed</b>
                        }
                        else
                        {
                            <b class="ungraded">Practice run · not graded</b>
                        }
                        <div class="case-tabs">
                            @for (int k = 0; k < run.Cases.Count; k++)
                            {
                                int idx = k;
                                var c = run.Cases[k];
                                <button class="case-tab @(idx == selected ? "on" : "") @(c.Verdict?.Graded == false ? (c.Result?.Completed == true ? "ran" : "fail") : c.Verdict?.Passed == true ? "pass" : "fail")" @onclick="() => SelectCase(idx)">
                                    <span class="dot"></span>@c.Case.Label
                                </button>
                            }
                        </div>
                    </div>

                    <div class="box-card">
                        <header><Icon Name="bolt" /> Result · @outcome.Case.Label</header>
                        <div class="body result-body">
                            @if (outcome.Verdict?.Graded == false)
                            {
                                <p class="verdict @(outcome.Result?.Completed == true ? "ran" : "fail")">@(outcome.Result?.Completed == true ? "• Ran (not graded)" : "✗ Error") — @outcome.Verdict?.Explanation</p>
                            }
                            else
                            {
                                <p class="verdict @(outcome.Verdict?.Passed == true ? "pass" : "fail")">@(outcome.Verdict?.Passed == true ? "✓ Passed" : "✗ Failed") — @outcome.Verdict?.Explanation</p>
                            }
                            <dl>
                                <dt>Input</dt><dd><code>@problem.Describe(outcome.Case.Args)</code></dd>
                                @if (outcome.Verdict?.Expected is { } expected)
                                {
                                    <dt>Expected</dt><dd><code>@expected</code>@if (outcome.Verdict.Graded == false) { <span class="field-hint"> (from the source, not verified)</span> }</dd>
                                }
                                @if (outcome.Result is { } r)
                                {
                                    @if (r.Completed)
                                    {
                                        <dt>Your output</dt><dd><code>@r.ResultJson</code></dd>
                                    }
                                    else
                                    {
                                        <dt>Exception</dt>
                                        <dd>
                                            <code class="err">@r.ErrorType: @r.ErrorMessage</code>
                                            @if (r.ErrorLine is > 0)
                                            {
                                                <button class="btn btn-sm btn-ghost" @onclick="() => Reveal(r.ErrorLine!.Value)">line @r.ErrorLine</button>
                                            }
                                        </dd>
                                    }
                                    @if (!string.IsNullOrEmpty(r.Output))
                                    {
                                        <dt>Console</dt><dd><pre class="console">@r.Output</pre></dd>
                                    }
                                }
                            </dl>
                        </div>
                    </div>

                    <div class="stage" style="--dur:@(player.AnimationMs)ms">
                        <div class="ps-callout tone-@(Frame?.Step.Callout?.Tone.ToString().ToLowerInvariant() ?? "none")">
                            @if (Frame?.Step.Callout is { } callout)
                            {
                                <span @key="@(player.Index + callout.Text)">@callout.Text</span>
                            }
                        </div>
                        @if (Frame is { } f)
                        {
                            @if (f.Containers.Count == 0)
                            {
                                <p class="lab-empty">No arrays, strings being indexed, collections, lists or trees are in scope at this step. Variables are shown below.</p>
                            }
                            @foreach (var c in f.Containers)
                            {
                                <div class="lab-container" @key="c.Title">
                                    <div class="lab-container-title">@c.Title</div>
                                    @if (c.Array is { } arr)
                                    {
                                        <ArrayCanvas Frame="arr" />
                                    }
                                    else if (c.Map is { } map)
                                    {
                                        <MapCanvas Frame="map" />
                                    }
                                    else if (c.Graph is { } graph)
                                    {
                                        <GraphCanvas Frame="graph" />
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="message @(Frame?.Kind == AlgoSharp.Tracing.TraceEventKind.Exception ? "error" : player.AtEnd && player.Steps.Count > 1 ? "done" : "")" aria-live="polite">
                        <span class="step-no">line @(Frame?.Line ?? 0)</span>
                        <p @key="player.Index">@Frame?.Step.Message</p>
                    </div>
                    <PlaybackControls Player="player" />
                    <CounterStrip Counters="@(Frame?.Step.Counters ?? [])" Previous="@player.Previous?.Counters" Steps="player.Steps.Count" />

                    <div class="box-card">
                        <header><Icon Name="vars" /> Variables <span class="muted">your names</span></header>
                        <div class="body"><VariableInspector Vars="@(Frame?.Step.Vars ?? [])" Previous="@player.Previous?.Vars" /></div>
                    </div>
                }
                else if (run is null || run.Cases.Count == 0)
                {
                    <div class="lab-placeholder">
                        <Icon Name="play" />
                        <h2>Solve it your way, then watch it run</h2>
                        <p>Write any correct C# you like. Press <b>Run &amp; visualize</b>: your code runs in the sandbox against the test cases below, and every line it executes, condition it checks, and array, list or tree it touches is recorded so you can step through it, forwards and backwards.</p>
                    </div>
                }
            </section>
            }
        </div>

        @if (signedIn)
        {
        <div class="lab-bottom">
            <div class="box-card">
                <header><Icon Name="vars" /> Test cases <span class="muted">@cases.Count / @MaxCases</span></header>
                <div class="body">
                    <div class="case-list">
                        @for (int k = 0; k < cases.Count; k++)
                        {
                            int idx = k;
                            var c = cases[k];
                            <div class="case-row">
                                <span><b>@c.Label</b> <code>@problem.Describe(c.Args)</code></span>
                                <button class="icon-btn" title="Remove" aria-label="Remove test case" disabled="@(cases.Count <= 1)" @onclick="() => RemoveCase(idx)">✕</button>
                            </div>
                        }
                    </div>
                    @if (problem.Params.Count > 0)
                    {
                    <div class="field-row case-inputs" style="--params:@problem.Params.Count">
                        @foreach (var p in problem.Params)
                        {
                            <div class="field">
                                <label for="new-@p.Name">@p.Name</label>
                                <input id="new-@p.Name" value="@newArgs[p.Name]" placeholder="@p.Placeholder" spellcheck="false"
                                       @onchange="e => newArgs[p.Name] = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        }
                    </div>
                    @if (caseError is not null)
                    {
                        <p class="field-error" style="margin-top:8px">@caseError</p>
                    }
                    }
                    <div class="actions-row">
                        @if (problem.Params.Count > 0)
                        {
                        <button class="btn btn-sm" disabled="@(cases.Count >= MaxCases)" @onclick="AddCase">Add case</button>
                        }
                        @if (problem.RandomCase is not null)
                        {
                            <button class="btn btn-sm" disabled="@(cases.Count >= MaxCases)" @onclick="AddRandomCase"><Icon Name="shuffle" /> Random case</button>
                        }
                        <button class="btn btn-sm btn-ghost" @onclick="ResetCases"><Icon Name="reset" /> Default cases</button>
                    </div>
                    @if (userProblem is null)
                    {
                        <p class="field-hint" style="margin-top:8px">Expected outputs for your own cases are computed by AlgoSharp's reference solution.</p>
                    }
                    else if (problem.Params.Count > 0)
                    {
                        <p class="field-hint" style="margin-top:8px">Your own cases run without grading (they have no verified expected output). Add verified tests in Edit to grade them.</p>
                    }
                    else
                    {
                        <p class="field-hint" style="margin-top:8px">Practice mode runs your Main() once. Add a method signature in Edit to run against test cases.</p>
                    }
                    @if (userProblem is not null && setup?.EffectiveMode == ProblemMode.Practice)
                    {
                        <button class="btn btn-sm" style="margin-top:8px" @onclick="ToggleSolved">@(Status == ProblemStatus.Solved ? "Mark as not solved" : "Mark as solved")</button>
                    }
                </div>
            </div>

            <div class="box-card">
                <header><Icon Name="info" /> Learning assistant</header>
                <div class="body assistant">
                    @if (advice is { } a)
                    {
                        <div class="assist-head">
                            <span class="tag-chip">@a.Approach</span>
                            <span class="assist-cx">Time <code>@a.Time</code> · Space <code>@a.Space</code></span>
                        </div>
                        <p>@a.Explanation</p>
                        <p class="field-hint">Complexity: @a.Confidence.</p>
                        @if (a.Observations.Count > 0)
                        {
                            <ul class="ideas">@foreach (var o in a.Observations) { <li>@o</li> }</ul>
                        }
                        @foreach (var s in a.Suggestions)
                        {
                            <p class="assist-suggest">@s</p>
                        }
                    }
                    else
                    {
                        <p class="vars-empty">Compile your code to get an explanation of its approach.</p>
                    }
                    <div class="hints">
                        @for (int k = 0; k < hintsShown && k < problem.Hints.Count; k++)
                        {
                            <p class="hint"><b>Hint @(k + 1).</b> @problem.Hints[k]</p>
                        }
                        @if (hintsShown < problem.Hints.Count)
                        {
                            <button class="btn btn-sm btn-ghost" @onclick="() => hintsShown++">Show hint @(hintsShown + 1) of @problem.Hints.Count</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        }

        @if (navCount > 1)
        {
            <nav class="pnav" aria-label="Problem navigation">
                @if (prevLink is { } prev)
                {
                    <a class="pnav-card prev" href="@prev.Href">
                        <small>← Previous</small>
                        <span>@prev.Title</span>
                    </a>
                }
                else
                {
                    <span class="pnav-card placeholder"></span>
                }
                <div class="pnav-middle">
                    <span>Problem @(navIndex + 1) of @navCount</span>
                    <small>@navScope</small>
                    <div class="pnav-dots" aria-hidden="true">
                        @for (int k = 0; k < navCount && navCount <= 30; k++)
                        {
                            <i class="@(k == navIndex ? "on" : "")"></i>
                        }
                    </div>
                </div>
                @if (nextLink is { } next)
                {
                    <a class="pnav-card next @(Status == ProblemStatus.Solved || AllPassed ? "ready" : "")" href="@next.Href">
                        <small>@(Status == ProblemStatus.Solved || AllPassed ? "Nice work! Up next →" : "Next problem →")</small>
                        <span>@next.Title</span>
                    </a>
                }
                else
                {
                    <a class="pnav-card next done" href="@(userProblem is null ? "/problems" : "/problems/mine")">
                        <small>You've reached the end</small>
                        <span>Back to @(userProblem is null ? "all problems" : "My Problems")</span>
                    </a>
                }
            </nav>
        }
    </div>
}

@code {
    private const int MaxCases = 10;

    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// The editor, compile checks, drafts and Run are the signed-in workspace. This is enforced here on the
    /// server (nothing is compiled, loaded, saved or run for anonymous visitors), not just hidden in the UI.
    /// </summary>
    private bool signedIn;
    private string? accountId;

    private string ReturnPath => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0];
    private string SignInHref => $"/account/login?returnUrl={Uri.EscapeDataString(ReturnPath)}";
    private string SignUpHref => $"/account/register?returnUrl={Uri.EscapeDataString(ReturnPath)}";

    private UserProblem? userProblem;
    private SolveSetup? setup;
    private ProblemProgress? progress;
    private bool pendingUserLoad;
    private string? storageError;
    private string draftState = "";

    private sealed record ProblemLink(string Href, string Title);

    private ProblemLink? prevLink, nextLink;
    private int navIndex, navCount;
    private string navScope = "";

    /// <summary>True when the latest run had graded cases and all of them passed.</summary>
    private bool AllPassed => run is { } r && r.Cases.Any(c => c.Verdict?.Graded == true) && r.Cases.Where(c => c.Verdict?.Graded == true).All(c => c.Verdict!.Passed);

    private bool InBrowser => Executor is BrowserModeExecutor;
    private ProblemStatus Status => progress?.Status ?? ProblemStatus.NotStarted;
    private string StatusLabel => Status switch { ProblemStatus.InProgress => "In progress", ProblemStatus.Solved => "Solved", _ => "Not started" };

    private readonly Player player = new();
    private readonly Random rng = new();
    private PlaygroundProblem? problem;
    private List<PlaygroundCase> cases = [];
    private readonly Dictionary<string, string> newArgs = [];
    private CompileResult? compile;
    private PlaygroundRun? run;
    private Advice? advice;
    private SandboxStatus? status;
    private int selected;
    private bool running;
    private int hintsShown;
    private string? caseError;
    private string? editorError;
    private string code = "";
    private string? loadedSlug;

    private ElementReference editorHost;
    private IJSObjectReference? module;
    private IJSObjectReference? editor;
    private DotNetObjectReference<SolveIt>? selfRef;
    private (int Case, int Index, int Line) highlighted = (-1, -1, -1);

    private CaseOutcome? Selected => run is { Cases.Count: > 0 } r ? r.Cases[Math.Min(selected, r.Cases.Count - 1)] : null;

    private TraceFrame? Frame => Selected is { Frames.Count: > 0 } o ? o.Frames[Math.Min(player.Index, o.Frames.Count - 1)] : null;

    protected override void OnInitialized() => player.Changed += () => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        signedIn = user?.Identity?.IsAuthenticated == true;
        accountId = signedIn ? user!.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
        if (accountId is null) signedIn = false;
        if (Id is not null && !signedIn)
        {
            // Personal problems are only reachable through the [Authorize] page; refuse anything else.
            Nav.NavigateTo(SignInHref, forceLoad: true);
            return;
        }
        string key = Id is null ? Slug : "mine/" + Id;
        if (loadedSlug == key) return;
        if (userProblem is not null && editor is not null)
        {
            try
            {
                string latest = await editor.InvokeAsync<string>("getValue");
                if (latest != progress?.Draft)
                {
                    code = latest;
                    await SaveDraft();
                }
            }
            catch (JSDisconnectedException) { }
        }
        loadedSlug = key;
        prevLink = nextLink = null;
        navIndex = navCount = 0;
        userProblem = null;
        setup = null;
        progress = null;
        storageError = null;
        draftState = "";
        if (Id is not null)
        {
            // Personal problems live in IndexedDB, which is only reachable after the first render.
            // The editor's element is removed while loading, so release it; it's recreated afterwards.
            if (editor is not null)
            {
                try
                {
                    await editor.InvokeVoidAsync("dispose");
                    await editor.DisposeAsync();
                }
                catch (JSDisconnectedException) { }
                editor = null;
            }
            problem = null;
            run = null;
            player.Load([], false);
            pendingUserLoad = true;
            return;
        }
        problem = PlaygroundCatalog.Find(Slug);
        if (problem is not null)
        {
            var all = PlaygroundCatalog.All;
            int at = all.ToList().FindIndex(p => p.Slug == problem.Slug);
            navIndex = at;
            navCount = all.Count;
            navScope = "Practice set";
            prevLink = at > 0 ? new($"/problems/{all[at - 1].Slug}", all[at - 1].Title) : null;
            nextLink = at + 1 < all.Count ? new($"/problems/{all[at + 1].Slug}", all[at + 1].Title) : null;
        }
        run = null;
        hintsShown = 0;
        caseError = null;
        player.Load([], false);
        if (problem is null) return;
        cases = [.. problem.DefaultCases];
        newArgs.Clear();
        foreach (var p in problem.Params) newArgs[p.Name] = p.Placeholder;
        code = problem.StarterCode;
        if (!signedIn) return; // description only: no compile, no sandbox status
        compile = PlaygroundService.Check(problem, code);
        RefreshAdvice();
        if (editor is not null)
        {
            try { await editor.InvokeVoidAsync("setValue", code); await PushMarkers(); } catch (JSDisconnectedException) { }
        }
        status = await Service.StatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!signedIn) return; // no editor, no IndexedDB access for anonymous visitors
        if (pendingUserLoad)
        {
            pendingUserLoad = false;
            await LoadUserProblem();
            StateHasChanged();
            return;
        }
        if (problem is null) return;
        if (editor is null && editorError is null)
        {
            try
            {
                selfRef ??= DotNetObjectReference.Create(this);
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor.js");
                editor = await module.InvokeAsync<IJSObjectReference>("create", editorHost, code, selfRef);
                await PushMarkers();
                if (InBrowser) await Browser.PrepareAsync(); // start the runtime download in the background
            }
            catch (JSException ex)
            {
                editorError = ex.Message;
                StateHasChanged();
            }
            catch (JSDisconnectedException) { }
            return;
        }
        if (editor is null) return;
        var now = (selected, player.Index, Frame?.Line ?? 0);
        if (now == highlighted) return;
        highlighted = now;
        string kind = Frame?.Kind == AlgoSharp.Tracing.TraceEventKind.Exception ? "error"
            : Frame?.Step.Callout?.Tone == CellState.Compare ? "cond-false" : "exec";
        try { await editor.InvokeVoidAsync("highlight", Frame?.Line ?? 0, kind); } catch (JSDisconnectedException) { }
    }

    private async Task LoadUserProblem()
    {
        var r = await Library.ProblemAsync(Id!);
        if (!r.Ok)
        {
            storageError = r.Error;
            return;
        }
        userProblem = r.Value!;
        setup = UserProblemAdapter.ToPlayground(userProblem);
        var siblings = await Library.ProblemsAsync();
        if (siblings.Ok)
        {
            var list = siblings.Value!
                .Where(x => x.Collection == userProblem.Collection)
                .OrderBy(x => x.Level ?? int.MaxValue).ThenBy(x => x.Title)
                .ToList();
            int at = list.FindIndex(x => x.Id == userProblem.Id);
            navIndex = at;
            navCount = list.Count;
            navScope = userProblem.Collection.Length > 0 ? userProblem.Collection : "Uncategorized";
            static string Name(UserProblem x) => (x.Level is int l ? $"Level {l}: " : "") + x.Title;
            prevLink = at > 0 ? new($"/problems/mine/{list[at - 1].Id}", Name(list[at - 1])) : null;
            nextLink = at >= 0 && at + 1 < list.Count ? new($"/problems/mine/{list[at + 1].Id}", Name(list[at + 1])) : null;
        }
        problem = setup.Problem;
        var g = await Library.ProgressAsync(Id!);
        progress = g.Value ?? new ProblemProgress { ProblemId = Id! };
        if (!g.Ok) storageError = g.Error;
        cases = [.. problem.DefaultCases];
        newArgs.Clear();
        foreach (var p in problem.Params) newArgs[p.Name] = p.Placeholder;
        code = string.IsNullOrEmpty(progress.Draft) ? problem.StarterCode : progress.Draft;
        draftState = string.IsNullOrEmpty(progress.Draft) ? "" : "Draft restored";
        compile = PlaygroundService.Check(problem, code);
        RefreshAdvice();
        run = null;
        hintsShown = 0;
        if (editor is not null)
        {
            try { await editor.InvokeVoidAsync("setValue", code); await PushMarkers(); } catch (JSDisconnectedException) { }
        }
        status = await Service.StatusAsync();
    }

    /// <summary>Saves the editor's code as this problem's draft (personal problems only).</summary>
    private async Task SaveDraft(ProblemStatus? newStatus = null)
    {
        if (!signedIn || userProblem is null || progress is null || problem is null) return;
        var status = newStatus ?? (progress.Status == ProblemStatus.Solved ? ProblemStatus.Solved
            : code.Trim() == problem.StarterCode.Trim() ? progress.Status : ProblemStatus.InProgress);
        var next = progress with
        {
            Draft = code,
            Status = status,
            SolvedAt = status == ProblemStatus.Solved ? progress.SolvedAt ?? DateTimeOffset.UtcNow : null,
        };
        var r = await Library.SaveProgressAsync(next);
        if (r.Ok)
        {
            progress = next;
            draftState = $"Draft saved {DateTime.Now:HH:mm:ss}";
        }
        else
        {
            draftState = "Draft not saved";
            storageError = r.Error;
        }
    }

    /// <summary>Explains the code's approach as soon as it compiles; a run adds measured observations.</summary>
    private void RefreshAdvice()
    {
        if (run is not null && run.Compile == compile) return;
        advice = compile is { Success: true, Tree: not null, MethodName: not null } c && problem is not null
            ? CodeAdvisor.Analyze(c.Tree, c.MethodName, [], problem.Hints.Count)
            : null;
    }

    private async Task ToggleSolved() => await SaveDraft(Status == ProblemStatus.Solved ? ProblemStatus.InProgress : ProblemStatus.Solved);

    [JSInvokable]
    public async Task OnCodeChanged()
    {
        if (!signedIn || editor is null || problem is null) return;
        code = await editor.InvokeAsync<string>("getValue");
        compile = PlaygroundService.Check(problem, code);
        RefreshAdvice();
        await PushMarkers();
        await SaveDraft();
        StateHasChanged();
    }

    private async Task PushMarkers()
    {
        if (editor is null || compile is null) return;
        try
        {
            object markers = compile.Diagnostics.Select(d => new { line = d.Line, column = d.Column, message = d.Message, severity = d.Severity }).ToArray();
            await editor.InvokeVoidAsync("setMarkers", markers);
        }
        catch (JSDisconnectedException) { }
    }

    private async Task Visualize()
    {
        // Signing in never bypasses the sandbox: code runs only in the configured sandbox (Docker, the remote
        // executor, or this visitor's own WebAssembly worker), never in this process.
        if (!signedIn || problem is null || running) return;
        running = true;
        player.Load([], false);
        _ = Sound.PlayAsync(SoundCues.Start);
        StateHasChanged();
        try
        {
            if (editor is not null) code = await editor.InvokeAsync<string>("getValue");
            // Per-account quota first; the remote executor gets an opaque id, never the account id.
            using var lease = RunQuotas.TryAcquire(accountId!, out string? limited);
            if (lease is null)
            {
                Log.LogInformation("audit event=run outcome=throttled-web account={Account}", accountId);
                compile = PlaygroundService.Check(problem, code);
                run = new PlaygroundRun(compile, limited, [], null);
                _ = Sound.PlayAsync(SoundCues.Fail);
                return;
            }
            string caller = Executor is RemoteExecutor remote ? remote.CallerFor(accountId!) : accountId!;
            // Browser mode: the instrumented assembly runs in this visitor's own .NET WebAssembly worker.
            run = InBrowser
                ? await Service.RunWithAsync(problem, code, cases, Browser.RunAsync)
                : await Service.RunAsync(problem, code, cases, caller);
            Log.LogInformation("audit event=run outcome={Outcome} account={Account}", run.ExecutionError is null ? "executed" : "not-executed", accountId);
            compile = run.Compile;
            advice = run.Advice;
            await PushMarkers();
            selected = Math.Max(0, run.Cases.ToList().FindIndex(c => c.Verdict?.Passed != true));
            _ = Sound.PlayAsync(RunCue(run));
            LoadCase(autoplay: true);
            if (userProblem is not null)
            {
                var graded = run.Cases.Where(c => c.Verdict?.Graded == true).ToList();
                bool solved = setup?.EffectiveMode == ProblemMode.Challenge && graded.Count > 0 && graded.All(c => c.Verdict!.Passed);
                await SaveDraft(solved ? ProblemStatus.Solved : null);
            }
        }
        finally
        {
            running = false;
        }
    }

    /// <summary>All graded cases pass → success; anything failed or not run → fail; ungraded but clean → done.</summary>
    private static string RunCue(PlaygroundRun r)
    {
        if (!r.Compile.Success || r.ExecutionError is not null || r.Cases.Count == 0) return SoundCues.Fail;
        if (r.Cases.Any(c => c.Result is { Completed: false })) return SoundCues.Fail;
        var graded = r.Cases.Where(c => c.Verdict?.Graded == true).ToList();
        if (graded.Count > 0) return graded.All(c => c.Verdict!.Passed) ? SoundCues.Success : SoundCues.Fail;
        return SoundCues.Done;
    }

    private void SelectCase(int index)
    {
        selected = index;
        LoadCase(autoplay: false);
    }

    private void LoadCase(bool autoplay)
    {
        player.Load(Selected?.Frames.Select(f => f.Step).ToList() ?? [], autoplay);
        highlighted = (-1, -1, -1);
    }

    private async Task Reveal(int line)
    {
        if (editor is null) return;
        try { await editor.InvokeVoidAsync("reveal", line); } catch (JSDisconnectedException) { }
    }

    private async Task ResetCode()
    {
        if (problem is null) return;
        code = problem.StarterCode;
        if (editor is not null) await editor.InvokeVoidAsync("setValue", code);
        compile = PlaygroundService.Check(problem, code);
        RefreshAdvice();
        await PushMarkers();
        await SaveDraft();
    }

    private async Task RefreshStatus() => status = await Service.StatusAsync();

    private void AddCase()
    {
        try
        {
            var args = problem!.Params.Select(p => newArgs.GetValueOrDefault(p.Name) ?? "").ToArray();
            problem.Parse(args);
            cases.Add(new PlaygroundCase($"Custom {cases.Count + 1}", args));
            caseError = null;
        }
        catch (FormatException ex)
        {
            caseError = ex.Message;
        }
    }

    private void AddRandomCase()
    {
        for (int attempt = 0; attempt < 20; attempt++)
        {
            var args = problem!.RandomCase!(rng);
            try
            {
                problem.Parse(args);
                cases.Add(new PlaygroundCase($"Random {cases.Count + 1}", args));
                return;
            }
            catch (FormatException)
            {
            }
        }
    }

    private void RemoveCase(int index) => cases.RemoveAt(index);

    private void ResetCases() => cases = [.. problem!.DefaultCases];

    public async ValueTask DisposeAsync()
    {
        player.Dispose();
        try
        {
            if (editor is not null && userProblem is not null)
            {
                // Keep edits made in the last moments before navigating away.
                string latest = await editor.InvokeAsync<string>("getValue");
                if (latest != progress?.Draft)
                {
                    code = latest;
                    await SaveDraft();
                }
            }
            if (editor is not null)
            {
                await editor.InvokeVoidAsync("dispose");
                await editor.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
