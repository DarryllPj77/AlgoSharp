@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject SoundCues Sound
@implements IAsyncDisposable

<header class="topbar">
    <div class="topbar-inner">
        <a class="logo" href="/" aria-label="AlgoSharp home">
            <span class="logo-mark">A<span>#</span></span>
            AlgoSharp
        </a>
        <nav class="nav">
            <NavLink href="/" Match="NavLinkMatch.All">Library</NavLink>
            <NavLink href="/problems">Problem Solving</NavLink>
        </nav>
        <div class="topbar-right">
            @if (RendererInfo.IsInteractive)
            {
                <details class="soundmenu" data-catmenu>
                    <summary class="icon-btn" title="Sound effects" aria-label="Sound effects settings">
                        <Icon Name="@(muted ? "mute" : "volume")" />
                    </summary>
                    <div class="soundmenu-panel">
                        <label class="sound-row">
                            <span>Sound effects</span>
                            <input type="checkbox" role="switch" checked="@(!muted)" @onchange="e => SetSound(e.Value is true)" />
                        </label>
                        <label class="sound-row volume @(muted ? "off" : "")">
                            <span>Volume</span>
                            <input type="range" min="0" max="100" step="5" value="@volume" disabled="@muted" aria-label="Sound volume"
                                   @onchange="e => SetVolume(e.Value)" />
                            <output>@volume%</output>
                        </label>
                        <small>A soft sound for each step: tick for comparisons, pop for swaps and moves, click for reads and updates.</small>
                    </div>
                </details>
                <button class="icon-btn" title="Toggle light / dark" aria-label="Toggle color theme" @onclick="ToggleTheme">
                    <Icon Name="@(theme == "dark" ? "sun" : "moon")" />
                </button>
            }
            else
            {
                @* Server-rendered pages (account forms) have no circuit: forms.js handles this button. *@
                <button class="icon-btn theme-static" type="button" title="Toggle light / dark" aria-label="Toggle color theme" data-theme-toggle>
                    <span class="if-dark"><Icon Name="sun" /></span><span class="if-light"><Icon Name="moon" /></span>
                </button>
            }
            <a class="icon-btn" href="https://github.com/DarryllPj77/AlgoSharp" target="_blank" rel="noopener" title="Source on GitHub" aria-label="Source on GitHub">
                <Icon Name="github" />
            </a>
            <UserMenu />
        </div>
    </div>
    <CategoryNav />
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private IJSObjectReference? module;
    private string theme = "dark";
    private bool muted;
    private int volume = 60;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/app.js");
        theme = await module.InvokeAsync<string>("getTheme");
        muted = await Sound.IsMutedAsync();
        volume = (int)Math.Round(await Sound.GetVolumeAsync() * 100);
        StateHasChanged();
    }

    private async Task SetSound(bool on) => muted = await Sound.SetMutedAsync(!on);

    private async Task SetVolume(object? value)
    {
        if (!int.TryParse(value?.ToString(), out int v)) return;
        volume = (int)Math.Round(await Sound.SetVolumeAsync(Math.Clamp(v, 0, 100) / 100.0) * 100);
    }

    private async Task ToggleTheme()
    {
        if (module is null) return;
        theme = await module.InvokeAsync<string>("toggleTheme");
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
