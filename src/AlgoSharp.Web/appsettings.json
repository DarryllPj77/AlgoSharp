{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sandbox": {
    "Mode": "Docker",
    "Image": "algosharp-runner:1",
    "TimeoutSeconds": 15,
    "Memory": "256m",
    "Cpus": "1",
    "PidsLimit": 64,
    "MaxConcurrentRuns": 2,
    "MaxEvents": 2000,
    "MaxOutputChars": 8000
  }
}