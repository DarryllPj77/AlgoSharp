<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AlgoSharp.Core\AlgoSharp.Core.csproj" />
    <ProjectReference Include="..\AlgoSharp.Playground\AlgoSharp.Playground.csproj" />
    <ProjectReference Include="..\AlgoSharp.Accounts\AlgoSharp.Accounts.csproj" />
    <!-- Static files only: the .NET WebAssembly runner served at /wasm-runner/ and run in the visitor's browser. -->
    <ProjectReference Include="..\AlgoSharp.Wasm\AlgoSharp.Wasm.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Small instances (Render Free: 0.1 CPU, 512 MB): workstation, non-concurrent GC keeps the heap and threads lean. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Container builds (deploy/web.Dockerfile passes AlgoSharpReadyToRun=true): precompile the app and Roslyn to
         native code, so a cold 0.1-CPU instance doesn't run Roslyn on slow unoptimised JIT code for its first minutes.
         Set here rather than with `dotnet publish -r`, which would also retarget the browser-wasm runner project. -->
    <RuntimeIdentifier Condition="'$(AlgoSharpReadyToRun)' == 'true'">linux-x64</RuntimeIdentifier>
    <PublishReadyToRun Condition="'$(AlgoSharpReadyToRun)' == 'true'">true</PublishReadyToRun>
    <SelfContained Condition="'$(AlgoSharpReadyToRun)' == 'true'">false</SelfContained>
    <UserSecretsId>78ada1e9-8127-46d6-9548-b364f85fc082</UserSecretsId>
  </PropertyGroup>

</Project>
