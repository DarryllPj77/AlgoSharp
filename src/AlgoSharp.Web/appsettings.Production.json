{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "HttpsRedirection": false,
  "Database": {
    "MigrateOnStartup": false
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": [ "172.30.0.0/24" ]
  }
}
